# =============================================================================
# Pulsewatch — Environment Configuration Template
# Copy this file to .env and customize secrets before production deployment.
# =============================================================================

NODE_ENV=development

# -----------------------------------------------------------------------------
# Server / API
# -----------------------------------------------------------------------------
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# PostgreSQL (Prisma)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://pulsewatch:pulsewatch_dev_password@localhost:5432/pulsewatch?schema=public"

# -----------------------------------------------------------------------------
# Redis (BullMQ, Rate Limiting, Socket.IO Pub/Sub)
# -----------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# -----------------------------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET="change-me-in-production-min-32-characters-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_COOKIE_NAME="pw_refresh_token"
BCRYPT_ROUNDS=12

# Allow private/loopback targets ONLY during controlled automated integration tests
ALLOW_PRIVATE_MONITOR_TARGETS=false

# -----------------------------------------------------------------------------
# Worker & Monitoring Engine
# -----------------------------------------------------------------------------
WORKER_CONCURRENCY=25
NOTIFICATION_CONCURRENCY=10
MAX_RESPONSE_SIZE_BYTES=1048576
RAW_RESULT_RETENTION_DAYS=30
DAILY_ROLLUP_RETENTION_DAYS=365

# -----------------------------------------------------------------------------
# SMTP / Email Notifications (Defaults to local Mailpit in Docker Compose)
# -----------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Pulsewatch Alerts <alerts@pulsewatch.dev>"

# -----------------------------------------------------------------------------
# Frontend (Vite)
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_SOCKET_URL=http://localhost:4000
